# Copy to .env and adjust. Every variable has the MOQESH_ prefix.

# Storage
MOQESH_DB_PATH=moqesh.db
# MOQESH_WEB_DIST=web/dist          # path to the frontend build (auto if it sits next to the package)

# Ports
MOQESH_HONEYPOT_PORT=8080
MOQESH_DASHBOARD_PORT=5000

# Public URL of the Moqesh server (the one remote sensors connect to)
# MOQESH_PUBLIC_URL=https://moqesh.example.com

# Content generation
# MOQESH_SEED=                      # empty = a seed is generated per deployment (anti-fingerprint)
MOQESH_GENERATION_MODE=Template     # Template | Mimic | Static
# MOQESH_TARGET_URL=https://example.com   # Mimic only
# Built-in site profile (saas|corp|ecommerce|nonprofit): realistic route taxonomy, vocabulary and
# API collections without crawling. Empty = generic labyrinth by seed. More profiles:
# scripts/build_profile.py crawls an authorized site and generates moqesh/profiles/<name>.json.
# MOQESH_SITE_PROFILE=saas
MOQESH_REALISM_LEVEL=3              # 1..5

# World: multi-site INERT static content (primary source; replaces the generated labyrinth).
# The honeypot serves real files from a tree on disk; ONLY bytes, it never executes anything. With an
# active World the labyrinth is OFF (it was the source of the auto-generated-content giveaways).
MOQESH_WORLD_ENABLED=true
# MOQESH_WORLD_PATH=                # empty = next to the DB (<DB dir>/world)
MOQESH_WORLD_AUTOSEED=true          # if the World is empty, copy the packaged curated seed
# MOQESH_VOCABULARY_THEME=          # corporate|devops|saas|ecommerce ("" = by seed)
MOQESH_TARPIT_DELAY_MS=0            # fixed base delay per response (ms)

# Adaptive tarpit: the labyrinth is coherent and finite by default (undetectable); only when
# a session is confirmed as a hostile agent (high score) does intensity rise -> longer prose/logs and
# a growing delay that burns the agent's tokens/wall-clock. Invisible to human traffic.
MOQESH_ADAPTIVE_TARPIT=true
MOQESH_TARPIT_MAX_MS=6000          # max delay per response at intensity 3 (confirmed agent)
# "Brute burn" opt-in: at max intensity the API paginates endlessly again (breaks stealth,
# becomes fingerprintable again). OFF by default = the coherence invariant holds.
MOQESH_ALLOW_INFINITE_ON_CONFIRMED=false
# CTF scenario (corp-breach): false = realistic labyrinth only (max stealth, does not reveal the
# honeypot pattern); true = active lure (breadcrumb chain + credential-reuse gate).
MOQESH_SCENARIOS_ENABLED=false

# Detection / alerts
MOQESH_ALERT_SCORE_THRESHOLD=0.5
MOQESH_ALERT_MIN_REQUESTS=5

# Blocking / notifications
MOQESH_ENFORCE_BLOCK=true
MOQESH_AUTO_BLOCK_SCORE=0.0        # 0 = score-based auto-block disabled (credential_reuse always blocks)
# MOQESH_WEBHOOK_URL=
# MOQESH_WEBHOOK_SECRET=
MOQESH_ENABLE_IPTABLES=false

# Dashboard authentication (single admin)
MOQESH_ADMIN_USER=admin
# MOQESH_ADMIN_PASSWORD=            # empty = one is generated and printed to the log (once)
# MOQESH_SESSION_SECRET=           # empty = generated and persisted next to the DB (stable per deployment)
MOQESH_SESSION_MAX_AGE=86400       # session lifetime in seconds
MOQESH_COOKIE_SECURE=false         # true behind TLS (admin subdomain); false locally/over an http tunnel

# AI confirmation (optional; the system works without it)
MOQESH_AI_ENABLED=false
MOQESH_AI_PROVIDER=heuristic        # heuristic | openai
# MOQESH_AI_BASE_URL=https://openrouter.ai/api/v1
# MOQESH_AI_API_KEY=
# MOQESH_AI_MODEL=anthropic/claude-haiku-5.5

# Worldsmith: AI agent that builds/evolves the World + the lure (on demand).
# `python -m moqesh.worldsmith build|evolve`. Guide: docs/WORLDSMITH.md
MOQESH_WORLDSMITH_PROVIDER=stub     # stub (no AI) | api (Anthropic) | claude_cli (subscription)
# MOQESH_WORLDSMITH_MODEL=claude-sonnet-4-5
# MOQESH_WORLDSMITH_API_KEY=        # provider=api; if empty, falls back to MOQESH_AI_API_KEY
# MOQESH_WORLDSMITH_BASE_URL=https://api.anthropic.com
MOQESH_WORLDSMITH_PORTALS=4
# MOQESH_WORLDSMITH_BRAND=
# For claude_cli: export CLAUDE_CODE_OAUTH_TOKEN=$(claude setup-token)
