{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moqesh-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "services": [
    {
      "binding": "ORIGIN",
      "service": "moqesh-origin"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_SESSIONS",
        "class_name": "AgentSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentSession"]
    }
  ]
}
