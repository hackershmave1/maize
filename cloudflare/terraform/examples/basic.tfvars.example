account_id                      = "REPLACE_WITH_32_HEX_ACCOUNT_ID"
zone_id                         = "REPLACE_WITH_32_HEX_ZONE_ID"
protected_hostname              = "protected.example.invalid"
admin_hostname                  = "admin.example.invalid"
# "dns": forward ordinary traffic to the server behind protected_hostname's proxied DNS record.
# "worker": set origin_service_name to an existing Worker that already serves the app.
create_staging_origin           = false
origin_type                     = "dns"
origin_service_name             = ""
origin_service_environment      = "production"
installation_id                 = "REPLACE_WITH_RANDOM_INSTALLATION_ID"
bait_api_path                   = "/api/private/account"
lure_paths                      = ["/.env", "/.env.production", "/.git/config", "/.aws/credentials", "/config.json", "/wp-config.php.bak", "/backup.sql", "/api/v1/keys", "/swagger.json", "/api/private/account"]
allowlisted_sources             = []
access_team_domain              = "REPLACE_WITH_ACCESS_TEAM_DOMAIN"
access_allowed_emails           = ["operator@example.invalid"]
maze_duration_minutes           = 15
block_duration_hours            = 24
response_budget                 = 100
alert_grouping_minutes          = 5
retention_days                  = 30
access_session_duration         = "8h"
lure_key_secret_binding_name    = "LURE_KEY_SECRET"
alert_webhook_secret_binding_name = "ALERT_WEBHOOK_URL"
secret_rotation_revision        = "initial"
enable_public_route             = false
